# Dois jeitos de rodar (README.md → "Dois modos"):
#  - Local (só você): preencha GITHUB_TOKEN e, se quiser, JIRA_*. Deixe GITHUB_CLIENT_ID vazio.
#  - Hospedado (Vercel, para outras pessoas): preencha a seção "Modo hospedado" no fim
#    e deixe GITHUB_TOKEN, JIRA_* e PAINEL_SENHA vazios.

# ── GitHub (modo local) ──
# Token da SUA conta: o painel mostra os commits de quem é dono do token.
#  - Classic: escopos "repo" e "read:org" — cobre todas as orgs.
# Passo a passo para emitir: README.md → "1. Token do GitHub".
#  - Fine-grained: só leitura (Contents + Metadata), um token por dono de repositórios.
# Em organizações com SSO, autorize o token na organização.
GITHUB_TOKEN=

# Opcional: só repositórios destes donos (usuários/orgs), separados por vírgula
GITHUB_OWNERS=
# Opcional: repositórios que não entram ("dono/nome" ou "nome"), separados por vírgula
GITHUB_IGNORAR=

# ── Jira Cloud (modo local, opcional: título, tipo, prioridade e status dos chamados) ──
JIRA_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens → "Create API token" (sem scopes)
JIRA_API_TOKEN=
# Opcional: só estas chaves de projeto contam como chamado (ex.: ABC,XYZ)
JIRA_PROJETOS=

# ── Painel ──
# Início do período (ISO). Vazio = últimos 12 meses.
PAINEL_DESDE=
# Segundos entre consultas ao GitHub (padrão 300)
PAINEL_INTERVALO=
# "arquivo" força o uso da última coleta salva em data/ (sem chamar o GitHub)
PAINEL_FONTE=

# ── Acesso ao painel (modo local) ──
# Em produção (npm start) o painel exige senha. Sirva sempre por HTTPS.
PAINEL_USUARIO=admin
PAINEL_SENHA=
# true libera produção sem senha (só em rede fechada / atrás de outro login)
PAINEL_PUBLICO=
# Origens extras para o `npm run dev` (ex.: 192.168.0.10), separadas por vírgula
PAINEL_DEV_ORIGENS=

# ── Modo hospedado (cada pessoa entra com o próprio GitHub) ──
# Preencher GITHUB_CLIENT_ID liga este modo. Passo a passo: README.md → "Publicar na Vercel".
# GitHub App: Client ID e um client secret gerado na página do app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Chave que criptografa os cookies de login (32+ caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSAO_SEGREDO=
# Opcional: app OAuth 2.0 da Atlassian, para o botão "Conectar Jira"
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Opcional: endereço público (ex.: https://painel.vercel.app). Vazio = o do próprio pedido.
PAINEL_URL=
